{
  "name": "c3-language",
  "displayName": "C3 Language",
  "description": "Language support for C3 — thin client over m-lsp",
  "version": "0.1.0",
  "publisher": "mjandrews1",
  "license": "SEE LICENSE IN m-lsp",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:c3"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "c3",
        "aliases": ["C3", "c3"],
        "extensions": [".c3", ".c3i", ".c3t"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "c3",
        "scopeName": "source.c3",
        "path": "../../grammars/c3.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "c3Lsp.restart",
        "title": "C3 LSP: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "C3 LSP",
      "properties": {
        "c3Lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the m-lsp entry (default: bundled packages/server/src/main.ts run with bun)"
        },
        "c3Lsp.bunPath": {
          "type": "string",
          "default": "bun",
          "description": "Bun executable used to launch the server"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
